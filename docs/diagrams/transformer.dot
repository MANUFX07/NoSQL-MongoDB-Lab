digraph G { rankdir=BT; pad=0.15; ranksep=0.22; node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=10.5 fillcolor="#EAF1F8" color="#1F3A5F" width=2.9]; edge [color="#44546A"];
 t [label="Input tokens (prompt + generated so far)" shape=plaintext fillcolor=white];
 emb [label="Token embedding + RoPE positions"];
 subgraph cluster_b { label="× N decoder layers (16 in Llama 3.2 1B)"; labelloc=t; labeljust=r; fontname="Helvetica-Bold"; fontsize=10; style="rounded,dashed"; color="#6A1B9A";
  n1 [label="RMSNorm"]; att [label="Masked multi-head self-attention\n(grouped-query, KV cache)" fillcolor="#F3E8F8" color="#6A1B9A"]; a1 [label="Residual add" shape=circle width=0.3 fixedsize=false label="+" ];
  n2 [label="RMSNorm"]; ffn [label="Feed-forward (SwiGLU)" fillcolor="#F3E8F8" color="#6A1B9A"]; a2 [label="+" shape=circle width=0.3]; }
 out [label="Final norm → linear → softmax over vocabulary"]; nxt [label="Sample next token (temperature 0.2) → append, repeat" shape=plaintext fillcolor=white];
 t->emb->n1->att->a1->n2->ffn->a2->out->nxt; emb->a1 [style=dashed constraint=false]; a1->a2 [style=dashed constraint=false]; }

MONGO_URI=mongodb://localhost:27017
MONGO_DB=llm_chat_app
# ollama | openai | extractive
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
# SLMs: llama3.2:1b  qwen2.5:1.5b  phi3:mini  gemma2:2b   LLM: llama3.1:8b
OLLAMA_MODEL=llama3.2:1b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# hash | ollama | mock     (ollama -> set OLLAMA_EMBED_MODEL=nomic-embed-text and EMBEDDING_DIM=768)
EMBEDDING_BACKEND=hash
EMBEDDING_DIM=384
# local (brute-force cosine) | atlas ($vectorSearch, create deploy/atlas_vector_index.json first)
VECTOR_SEARCH=local
CHUNK_SIZE=120
CHUNK_OVERLAP=20
TOP_K=3
